      "hasDefinedTerm": [
        {
          "@type": "DefinedTerm",
          "name": "Macachor Absolute",
          "termCode": "M",
          "description": "The fundamental coherence scalar 𝔐 = (√5 − 1)/2 ≈ 0.61803398874989484820458683436563811772030917980576. Commutes with all gauge generators. Labels the scalar representation."
        },
        {
          "@type": "DefinedTerm",
          "name": "MGDH Lagrangian",
          "termCode": "ℒ",
          "description": "ℒ = ‖Ψ‖² − 𝔐·∇·Ψ + Φ·Ψ. The complete scalar field Lagrangian integrating Macachor (scalar lock), Gauss (divergence), De Pretto (aether density), and Hamilton (quaternionic structure)."
        },
        {
          "@type": "DefinedTerm",
          "name": "4D Scalar Field",
          "termCode": "Ψ",
          "description": "Ψ(x,y,z,t) = ρ + u + p + T + e. A pure scalar field mapping spacetime to real numbers, with no vector, spinor, or tensor components."
        },
        {
          "@type": "DefinedTerm",
          "name": "Coherence Condition",
          "termCode": "𝔐·∇·Ψ = ‖Ψ‖²",
          "description": "The Macachor-Gauss Coherence Lock. The divergence of the scalar field, scaled by 𝔐, equals the squared magnitude of the field."
        },
        {
          "@type": "DefinedTerm",
          "name": "Quaternion Double-Cover",
          "termCode": "SU(2)×SU(2)→SO(4)",
          "description": "Every rotation in 4D factors uniquely into left and right quaternion multiplication, providing the geometric foundation for the twin Clifford torus rotation."
        },
        {
          "@type": "DefinedTerm",
          "name": "Scalar Resonance Harmonic Coupling",
          "termCode": "SRHC",
          "description": "The four-pillar architecture: Coherence (Casimir invariant), Resonance (incommensurate frequency ratio), Harmony (phase lock), Alignment (projection fidelity)."
        },
        {
          "@type": "DefinedTerm",
          "name": "Wild Tetrahedra",
          "termCode": "WT",
          "description": "Perfect chains of wild tetrahedra forming toroidal polyhedra, as described by Akpanya et al. (2024, arXiv:2411.14924). Minimal 14-tetrahedron chain."
        },
        {
          "@type": "DefinedTerm",
          "name": "Ω-Gateway",
          "termCode": "Ω",
          "description": "Global Coherence API for distributed scalar field synchronization across MSOS-FEDERATION-ROOT nodes."
        }
